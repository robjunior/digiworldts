// Prisma schema — the datastore contract for @digimon/api (TASK-4, R-2, D-11).
//
// This is the project's FIRST persistence layer. It is deliberately SQLite for
// the first slice: file-based, zero-ops, and reversible. The Prisma datamodel
// and generated client API are provider-agnostic, so the eventual Postgres swap
// (R-3+) is a `provider` + `DATABASE_URL` change here plus a fresh migration —
// no application code changes (that is why SQLite is a two-way door). Do NOT wire
// Postgres/docker-compose now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider is fixed to sqlite for this slice; DATABASE_URL is read from the
  // environment (see apps/api/.env.example) with a `file:./prisma/dev.db` default
  // applied in application code (the house `process.env.X ?? default` idiom —
  // there is no @nestjs/config). Tests point this at a throwaway file so the gate
  // never mutates the shared dev.db.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A user account — the root identity record the auth loop (TASK-5) builds on.
/// This slice only proves it round-trips (create + read back); no auth logic yet.
model User {
  // String PK generated as a cuid() so IDs are collision-resistant and portable
  // across the future Postgres swap (no DB-specific auto-increment to migrate).
  id String @id @default(cuid())

  // Login identity. @unique enforces one account per email at the DB level so a
  // duplicate registration fails atomically rather than racing in app code.
  email String @unique

  // The bcrypt hash of the password — NEVER the plaintext. TASK-5 populates this;
  // it is stored here so the credential never lives anywhere but hashed at rest.
  passwordHash String

  // Authorization tier (TASK-34, R-14) — the FIRST tier beyond bare "authenticated".
  // One of "user" | "admin". Modeled as a plain String, NOT a Prisma `enum`: the
  // SQLite provider does not support enums (an `enum { … }` block fails `prisma
  // generate` / `db push`, L-6 #3) — the allowed set lives as a TS check in
  // application code. `@default("user")` makes this a purely ADDITIVE column
  // (invariant 5): every one of the pre-R-14 rows reads "user", so no existing
  // account silently gains privilege and the 7 committed migrations stay byte-stable.
  // The first admin is BOOTSTRAPPED from config (the ADMIN_EMAILS env var) on
  // register/login — see AuthService — not by hand-editing this column. The role
  // rides the access-token JWT (AccessTokenPayload) so AdminGuard authorizes off the
  // token with no DB round-trip.
  role String @default("user")

  // Ranked-PvP rating (TASK-36, R-12) — the player's matchmaking rating (MMR). One
  // of the R-12 ranked ladder's core state: challenging another real player runs the
  // deterministic combat sim and moves BOTH players' `mmr` by a standard Elo step
  // (see pvp/rating.ts). Modeled as an `Int` in WHOLE units — the house numeric idiom
  // (exactly like `xp` / `dataFire` / `level`), no Float/Decimal. `@default(1000)` is
  // the conventional Elo seed AND makes this a purely ADDITIVE column (invariant 5):
  // every pre-R-12 row reads 1000, so the 8 committed migrations stay byte-stable and
  // no account's rating changes silently on deploy. MMR is DOMAIN progression, NOT a
  // spendable economic resource — like `xp`, it is NOT a `ResourceBalance` and a
  // rating move writes NO `AuditLog` row (invariant 3 is NOT triggered; the ledger is
  // for value-moving mutations, L-12). MMR-based matchmaking + a live queue + a
  // leaderboard are carved R-12 child slices; this column + the direct-challenge
  // write-path is the foundation they reuse.
  mmr Int @default(1000)

  // Premium-Time expiry (TASK-38, R-13b) — the instant until which this player's
  // purchased PREMIUM TIME (a QoL production boost) is active, or NULL for "no
  // premium". Buying the Premium-Time shop item (shop/shop.seed.ts) EXTENDS this from
  // max(now, existing) so stacked purchases add up rather than reset. While `now <
  // premiumUntil` FarmService multiplies the player's farm production by
  // PREMIUM_PRODUCTION_MULTIPLIER (a PvE/QoL bonus). Modeled `DateTime?` with NO
  // default, making this a purely ADDITIVE column (invariant 5): every pre-R-13b row
  // reads NULL, so the 9 committed migrations stay byte-stable and no account silently
  // gains a boost.
  //
  // THE HARD GUARANTEE (the ethical-monetization point of R-13b): this column is read
  // ONLY by ShopService (the purchase + the shop read) and FarmService (the boosted
  // accrual). PvP — PvpService, simulateBattle, the Elo step — NEVER reads it, so a
  // premium boost can NEVER touch ranked combat (spend premium currency only on QoL,
  // never pay-to-win). premiumUntil is a domain flag, not a spendable resource; the
  // SPEND that grants it debits DigiCredits + writes the existing 'purchase' AuditLog
  // row (invariant 3), and this column itself carries no ResourceBalance/ledger.
  premiumUntil DateTime?

  // Last-activity timestamp (TASK-44, R-11 — the social friends slice) — the instant
  // this account was last seen active, or NULL for "never seen since this column was
  // added". Stamped as a pure write side-effect on every `GET /api/auth/me` (which
  // every authed screen calls on boot), so presence stays fresh with NO new plumbing.
  // The friends list derives an `online` boolean from it (SocialService: online =
  // lastSeenAt != null && now - lastSeenAt < ONLINE_WINDOW_MS). Modeled `DateTime?`
  // with NO default, making this a purely ADDITIVE column (invariant 5): every pre-R-11
  // row reads NULL (= "offline / never seen"), so the 11 committed migrations stay
  // byte-stable and no account's presence changes silently on deploy. It is NOT
  // projected onto the `GET /auth/me` WIRE shape (MeResponse is byte-unchanged); it is
  // read ONLY by SocialService's friends view. Presence is a domain flag, not a
  // spendable resource — no ResourceBalance/AuditLog (invariant 3 untriggered).
  lastSeenAt DateTime?

  // Starter-City world spawn (TASK-48, R-17b) — the player's persisted spawn tile in
  // the deterministic Digiworld. NULL until the player first opens `/world`, at which
  // point WorldService computes a valid spawn (a walkable, non-city tile ≥
  // MIN_SPAWN_DISTANCE from the nearest city) via the PURE `findSpawnTile(seed)` from a
  // stable per-player seed and PERSISTS it here, so a re-read never moves the spawn.
  // City POSITIONS are NOT stored (a pure function of coordinates in world.map.ts); only
  // the player's chosen spawn tile persists — hence just these two columns. Modeled
  // `Int?` (whole tile coords, the house numeric idiom) with NO default, making this a
  // purely ADDITIVE change (invariant 5): every pre-R-17b row reads NULL = "no spawn
  // yet", so the 12 committed migrations stay byte-stable and no account's world
  // placement changes silently on deploy. Spawn placement is DOMAIN state, not spendable
  // value — no ResourceBalance/AuditLog (invariant 3 untriggered, like xp/mmr).
  spawnX Int?
  spawnY Int?

  // Daily-reward claim streak (TASK-235, R-40 — the server-authoritative daily-reward
  // claim loop). `dailyStreakDay` is the last-claimed day in the fixed 7-day cycle:
  // 0 = never claimed (a purely ADDITIVE default so every pre-R-40 row reads 0 and no
  // account silently gains a streak on deploy), 1..7 = the day granted by the most
  // recent claim; claiming advances it via the pure `advanceStreak` ((day % 7) + 1,
  // wrapping 7→1). `lastDailyClaimedAt` is the instant of that claim (NULL until the
  // first claim); the once-per-UTC-calendar-day gate compares it to `now` so a second
  // claim the same day is refused (no credit / no audit / streak unchanged). Modeled
  // `Int @default(0)` + `DateTime?` mirroring the additive `mmr`/`premiumUntil`/`spawn*`
  // precedents (invariant 5 — the 13 committed migrations stay byte-stable). The claim
  // GRANTS spendable value, so the credit + its append-only AuditLog row live in one
  // `$transaction` (invariant 3) — but these two columns are the streak STATE, not the
  // spendable resource itself (that is ResourceBalance).
  dailyStreakDay     Int       @default(0)
  lastDailyClaimedAt DateTime?

  // Purchasable inventory slot-expansion bonus (TASK-281, R-31b child iv) — the
  // per-user NUMBER of EXTRA distinct-stack slots this player has bought on top of
  // the flat `INVENTORY_SLOT_CAP` base (10). The effective cap the write-side
  // purchase guard (ShopService) and the read-side display (InventoryService) both
  // enforce is `INVENTORY_SLOT_CAP + inventorySlotBonus`. Buying the
  // `inventory_slot`-kind shop item increments this INSIDE the existing audited
  // purchase `$transaction` (invariant 3 — no cap raise without a matching audited
  // DigiCredits debit). Modeled `Int @default(0)` mirroring the additive
  // `mmr`/`dailyStreakDay` precedents (invariant 5): every pre-R-31b-iv row reads 0
  // (= the flat cap of 10, byte-identical prior behaviour), so the 16 committed
  // migrations stay byte-stable and no account's cap changes silently on deploy.
  // ADDITIVE-only this slice (an increment; there is no downgrade/reset path). The
  // bonus is DOMAIN state, not a spendable resource itself (that is ResourceBalance).
  inventorySlotBonus Int @default(0)

  createdAt DateTime @default(now())

  // Soft-delete marker (invariant 2: player-owned/economic rows are NEVER hard
  // DELETEd). Declared now, unused this slice: a User is "active" when this is
  // NULL and "deleted" once stamped. Later queries filter on `deletedAt: null`
  // instead of issuing a destructive DELETE. Declaring it in the first migration
  // means the soft-delete guarantee is baked in before any account data exists.
  deletedAt DateTime?

  // Back-relation to the player's OWNED Digimon (TASK-7, R-3). A pure Prisma
  // relation field — it adds NO column to the `User` table (the FK lives on
  // `Digimon.userId`), so this grows the schema additively (invariant 5) without
  // touching existing User data or the committed `init_user` migration.
  digimon Digimon[]

  // Back-relation to this user's issued refresh tokens (TASK-10, R-2b). Like
  // `digimon` above, a pure Prisma relation field — it adds NO column to `User`
  // (the FK lives on `RefreshToken.userId`), so the committed `init_user` /
  // `add_digimon` migrations stay byte-unchanged (invariant 5, additive). A user
  // has many refresh tokens over time (rotation issues a new one per refresh, the
  // old one soft-revoked), so this is a one-to-many.
  refreshTokens RefreshToken[]

  // Back-relation to the player's OWNED buildings (TASK-14, R-4 — the resource
  // economy). Same established move as `digimon` / `refreshTokens` above: a pure
  // Prisma relation field that adds NO column to `User` (the FK lives on
  // `Building.userId`), so the three committed migrations (`init_user`,
  // `add_digimon`, `add_refresh_token`) stay byte-unchanged (invariant 5,
  // additive). A player owns many buildings, so this is a one-to-many.
  buildings Building[]

  // Back-relation to this user's spendable resource balances (TASK-21, R-4b — the
  // economy's persistence foundation). Same established move as `buildings` above:
  // a PURE Prisma relation field that adds NO column to `User` (the FK lives on
  // `ResourceBalance.userId`), so the four committed migrations (`init_user`,
  // `add_digimon`, `add_refresh_token`, `add_building`) stay byte-unchanged
  // (invariant 5, additive). One row per (user, resource) — see the model's
  // `@@unique` — so a user has at most a handful, but it is still a one-to-many.
  resourceBalances ResourceBalance[]

  // Back-relation to this user's append-only audit ledger rows (TASK-21, R-4b —
  // invariant 3's machinery). Another pure relation field adding NO `User` column
  // (the FK lives on `AuditLog.userId`); the four committed migrations stay
  // byte-unchanged (invariant 5). A user accumulates many audit rows over time
  // (every economic/admin mutation appends one), so this is a one-to-many.
  auditLogs AuditLog[]

  // Back-relation to this user's market listings (TASK-42, R-10 — the player
  // market). Same established move as `digimon` / `auditLogs` above: a PURE Prisma
  // relation field that adds NO column to `User` (the FK lives on
  // `MarketListing.sellerId`), so the ten committed migrations stay byte-unchanged
  // (invariant 5, additive). A seller lists many Digimon over time, so this is a
  // one-to-many. Only the SELLER side is modeled here (the buyer never becomes a
  // permanent relation to a listing — the sale reassigns the Digimon's `userId` and
  // marks the listing `sold`, no buyer FK needed for this slice).
  marketListings MarketListing[]

  // Back-relations to this user's friendship edges (TASK-44, R-11 — the social
  // friends slice). Two PURE Prisma relation fields (they add NO column to `User` —
  // the FKs live on `Friendship.requesterId`/`addresseeId`), so the eleven committed
  // migrations stay byte-unchanged (invariant 5, additive). A friendship is directional
  // at creation (a requester → an addressee), so the two sides are DISTINCT named
  // relations: `sentFriendRequests` are edges this user initiated, `receivedFriendRequests`
  // are edges pointing AT this user (the ones they may accept). Both one-to-many.
  sentFriendRequests     Friendship[] @relation("FriendRequests")
  receivedFriendRequests Friendship[] @relation("FriendRequestsReceived")

  // Back-relation to this user's OWNED inventory items (TASK-262, R-31b — the
  // space-limited player inventory of consumable chips). Same established move as
  // `buildings`/`resourceBalances` above: a PURE Prisma relation field that adds NO
  // column to `User` (the FK lives on `InventoryItem.userId`), so the fifteen committed
  // migrations stay byte-unchanged (invariant 5, additive). One row per (user, item
  // slug) — see InventoryItem's `@@unique` — so a grant is a clean upsert-increment;
  // still a one-to-many.
  inventoryItems InventoryItem[]
}

/// A player-OWNED Digimon instance (TASK-7, R-3) — the project's first domain
/// model beyond `User`. This is NOT a shared species catalog: each row is one
/// creature belonging to one player (R-3: "*their* roster of owned Digimon"), so
/// TASK-8's `GET /digimon` returns exactly the signed-in user's rows and TASK-9
/// renders them. Later slices (acquisition R-8, evolution R-6, training R-4,
/// trade R-10) mutate these rows; this slice only models + round-trips one.
model Digimon {
  // House PK idiom (matches User): a cuid() string, collision-resistant and
  // portable across the future Postgres swap — NOT a DB auto-increment to migrate.
  id String @id @default(cuid())

  // The owning player. `userId` is the FK column; `user` is the relation to the
  // owner. This is what makes a Digimon an OWNED instance and powers the roster
  // query `findMany({ where: { userId, deletedAt: null } })` (TASK-8).
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Display name of the creature, e.g. "Agumon".
  name String

  // The attribute-triangle value — one of "Vaccine" | "Virus" | "Data" | "Free".
  // Modeled as a plain String, NOT a Prisma `enum`: the SQLite provider does not
  // support enums (an `enum { … }` block fails `prisma generate` / `db push`).
  // The allowed set is enforced in application code where needed (TASK-8), not in
  // the schema — and the eventual Postgres swap can tighten this to an enum then.
  type String

  // The elemental affinity — e.g. "Fire" | "Water" | "Nature" | "Electric" |
  // "Neutral". Plain String for the same SQLite-no-enums reason as `type`.
  element String

  // The evolution stage — e.g. "Fresh" | "In-Training" | "Rookie" | "Champion" |
  // "Ultimate" | "Mega". Plain String (SQLite-no-enums). Evolution (R-6) advances
  // this later; a starter is a "Rookie".
  stage String

  // Core battle stats. Ints keep the schema portable and the model simple for
  // this slice; balancing/derivation is a later concern (R-4 training, R-7 PvP).
  hp    Int
  atk   Int
  def   Int
  spd   Int
  level Int @default(1)

  // Accumulated experience TOWARD the next level (TASK-29, R-6) — the first column
  // that actually MOVES progression. A discrete `POST /digimon/:id/train` grants a
  // fixed XP amount; when `xp` crosses the per-level threshold (see training.ts) the
  // `level` ticks up (with a flat stat gain) and the overflow carries into the next
  // level. Purely ADDITIVE (invariant 5): a NEW defaulted column (`@default(0)` — an
  // existing pre-training Digimon reads 0) added AFTER `level`, so the five committed
  // migrations stay byte-stable and `GET /digimon`/`OwnedDigimon` only GROW (the new
  // `xp`/`xpToNext` fields are additive on the projection). Int, whole units, the
  // house idiom. XP is DOMAIN progression, NOT a spendable economic resource, so it
  // is NOT a `ResourceBalance` (invariant 3 is not triggered — training is free).
  xp    Int @default(0)

  // Accumulated typed FIRE DATA (TASK-30, R-16) — the mechanism that lets a player
  // steer WHERE a Digimon evolves, not just when. A discrete `POST /digimon/:id/train`
  // grants a fixed amount of Fire Data ALONGSIDE the XP grant (no new Data source in
  // this slice); once `dataFire` crosses a threshold (see evolution.ts's variant
  // `requiredData`) a SECOND, VARIANT evolution branch (e.g. Agumon → Meramon instead
  // of the linear Agumon → Greymon) becomes available. Purely ADDITIVE (invariant 5):
  // a NEW defaulted column (`@default(0)` — an existing Digimon reads 0) added AFTER
  // `xp`, so the six committed migrations stay byte-stable and `GET /digimon`/
  // `OwnedDigimon` only GROW. Int, whole units, the house idiom. Fire Data — like
  // `xp`/`level` — is DOMAIN progression, NOT a spendable economic resource, so it is
  // NOT a `ResourceBalance` and its GRANT writes NO `AuditLog` row (invariant 3 is not
  // triggered — the Data grant moves no value; only the priced VARIANT evolve does).
  dataFire Int @default(0)

  // The server-authoritative TRAINING START timestamp (TASK-189, R-26 slice 48) —
  // the first column that lets training accrue over ELAPSED REAL TIME instead of the
  // old instant flat per-click grant. `POST /digimon/:id/train/start` stamps this to
  // `now()`; `POST /digimon/:id/train/collect` reads it, computes the server-side
  // elapsed (`Date.now() - trainingStartedAt` — invariant 1, NEVER client-supplied),
  // applies the elapsed-scaled gain via the pure `applyTimedTraining`, and CLEARS this
  // back to NULL. NULL means "not currently training". Purely ADDITIVE (invariant 5):
  // a NULLABLE column with NO default — every existing row reads NULL, so the shipped
  // migrations stay byte-stable and `OwnedDigimon` only GROWS (the additive-optional
  // `trainingStartedAt` projection). Training moves DOMAIN progression (stat/XP), NOT a
  // spendable resource, so no ResourceBalance/AuditLog (invariant 3 untriggered).
  trainingStartedAt DateTime?

  // TASK-255 (R-31a): the player's chosen PARTY slot for this Digimon — 1, 2, or 3,
  // or NULL when it is NOT in the party. Persists which (up to 3) owned Digimon a
  // player has PICKED for their party, replacing the read-only `slice(0,3)` view the
  // Party rail shipped with (TASK-243/L-149). Set/cleared by `POST /digimon/:id/party`
  // (owner-scoped, one Digimon per slot); surfaced on `GET /digimon` so a follow-on
  // client control renders it. Purely ADDITIVE (invariant 5): a NULLABLE column with
  // NO default — every existing row reads NULL, so the shipped migrations stay
  // byte-stable and `OwnedDigimon` only GROWS (the additive-optional `partySlot`
  // projection). Party is DOMAIN state, NOT a spendable resource, so no
  // ResourceBalance/AuditLog (invariant 3 untriggered), exactly like training/spawn.
  partySlot Int?

  createdAt DateTime @default(now())

  // Soft-delete marker (invariant 2: player-owned/economic records are NEVER hard
  // DELETEd — a Digimon is owned/active when this is NULL). Reads MUST filter
  // `deletedAt: null`; releasing/trading a Digimon later stamps this rather than
  // issuing a destructive DELETE. No delete path is built this slice; the marker
  // is declared in the FIRST Digimon migration so the guarantee predates the data.
  deletedAt DateTime?

  // Index the owner FK: the primary access path is "this player's roster"
  // (`WHERE userId = ?`), so the index keeps that query cheap as rosters grow.
  @@index([userId])
}

/// A single issued refresh token (TASK-10, R-2b) — the durable half of the
/// session. R-2b's goal: a player reloads the page / reopens the tab and is STILL
/// logged in without re-entering credentials, and logging out truly ends the
/// session server-side. The short-lived access token (JWT) lives in the SPA's
/// memory only; the long-lived credential that mints new access tokens is a
/// rotating refresh token kept in an httpOnly `SameSite=Lax` cookie the SPA's JS
/// can never read. THIS row is the server's record of one such issued token.
///
/// This slice is the model + migration ONLY. TASK-11 owns the write/read paths
/// (`/auth/refresh` rotates: verify the presented token's hash against an active
/// row, stamp `revokedAt`, issue a successor and link it via `rotatedToId`;
/// `/auth/logout` stamps `revokedAt`). Nothing but a Nest module (via
/// `PrismaService`) ever touches this table (invariant 1).
///
/// Shape mirrors `Digimon` deliberately (house model idiom, TASK-7): a cuid PK, a
/// `userId` FK + `@relation`, an `@@index([userId])`, a soft-revoke marker
/// (`revokedAt`, the invariant-2 analogue of `deletedAt`), and plain scalar
/// columns (SQLite has no enums).
model RefreshToken {
  // House PK idiom (matches User/Digimon): a cuid() string, collision-resistant
  // and portable across the future Postgres swap — NOT a DB auto-increment.
  id String @id @default(cuid())

  // The owning player. `userId` is the FK column; `user` is the relation to the
  // owner (a refresh token belongs to exactly one user). Mirrors Digimon's owner
  // relation exactly — a RESTRICT FK (Prisma's SQLite default) is correct here:
  // a token cannot outlive / be orphaned from its user, and users are soft-deleted
  // (never hard-DELETEd — invariant 2), so the RESTRICT is never actually hit.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // A HASH of the raw refresh token — NEVER the raw token itself. The raw token
  // lives ONLY in the user's httpOnly cookie; only its hash is persisted, so a
  // leaked DB row (a dump, a backup, a read-only breach) cannot be replayed to
  // resume a session — an attacker would need to reverse the hash. This is the
  // exact discipline `User.passwordHash` applies to passwords, applied to session
  // tokens. @unique both enforces "no two rows for the same token" at the DB level
  // (the guarantee TASK-11's rotation relies on) AND makes the lookup-by-token an
  // indexed point read. The hashing mechanism (sha-256 vs bcrypt) is TASK-11's
  // choice (A-9); this column only declares that a hash — never the raw value — is
  // what is stored, and that it is unique.
  tokenHash String @unique

  // Absolute expiry — mirrors the refresh JWT's `exp`. An "active token" lookup
  // filters `expiresAt > now()`, so an expired token stops working even if it was
  // never explicitly revoked (a bounded blast radius if a cookie leaks). Stored as
  // an absolute instant (not a TTL) so the check is a simple comparison and does
  // not depend on when the row is read.
  expiresAt DateTime

  // Soft-revoke marker (invariant 2, the `deletedAt` analogue for sessions):
  // NULL = active, a timestamp = revoked. Revoking a token STAMPS this rather than
  // issuing a destructive DELETE — so the session record (and, with `rotatedToId`,
  // the rotation history) survives for audit/reuse-detection. Set on rotation (the
  // old token is revoked as its successor is minted) and on logout. The active
  // lookup TASK-11 uses is `{ tokenHash, revokedAt: null, expiresAt: { gt: now } }`.
  revokedAt DateTime?

  // The id of the successor token this one rotated INTO. Single-use rotation
  // (A-9): each `/auth/refresh` revokes the presented token and issues a fresh one;
  // this column links old → new to form the rotation chain. It PAVES R-2c reuse
  // detection — presenting an already-rotated (revoked) token whose `rotatedToId`
  // is set is a replay signal that later hardening can act on (invalidate the whole
  // chain). NULL until this token is rotated. Left as a plain nullable String (not
  // a self-relation) on purpose: this slice only needs to RECORD the link, and a
  // self-relation would add a Prisma back-relation field + more migration surface
  // for no behaviour TASK-11 needs yet.
  rotatedToId String?

  createdAt DateTime @default(now())

  // Index the owner FK: TASK-11 lists / bulk-revokes a user's tokens by owner
  // (`WHERE userId = ?` — e.g. "log out everywhere"), so the index keeps that path
  // cheap as a user accumulates rotated tokens. (Lookup-by-`tokenHash` is already
  // indexed by its @unique.)
  @@index([userId])
}

/// A player-OWNED building instance (TASK-14, R-4) — the persistence foundation
/// of the resource economy. R-4's outcome: a signed-in player opens `/farm`, sees
/// their starting buildings (Meat Farm / Bit Bank / Data Center) and watches each
/// produce a resource over real time up to a storage cap, with production credited
/// on return after being offline. THIS row is one such owned building.
///
/// This slice is the model + migration + a pure starting-building seed ONLY —
/// running persistence code, proven by a datastore e2e that round-trips a row, NOT
/// a schema write-up. TASK-15 owns the read path (`GET /farm`: materialize the
/// starters on a first empty read like TASK-8's roster grant, and compute the
/// accrued buffer on read from `lastCollectedAt` — a pure timestamp diff, no
/// background job). The collect MUTATION + the append-only audit ledger it requires
/// (invariant 3) are R-4b; this read-side foundation writes nothing but its own
/// starter grant, so invariant 3 is NOT triggered here.
///
/// Shape mirrors `Digimon` deliberately (house owned-instance idiom, TASK-7): a
/// cuid PK, a `userId` FK + `@relation`, an `@@index([userId])`, a soft-delete
/// marker (`deletedAt`, invariant 2), plain-`String` categoricals (SQLite has no
/// enums), and `Int` numerics.
model Building {
  // House PK idiom (matches User/Digimon/RefreshToken): a cuid() string,
  // collision-resistant and portable across the future Postgres swap — NOT a DB
  // auto-increment to migrate.
  id String @id @default(cuid())

  // The owning player. `userId` is the FK column; `user` is the relation to the
  // owner. This is what makes a Building an OWNED instance and powers the per-owner
  // read `findMany({ where: { userId, deletedAt: null } })` (TASK-15). Mirrors
  // Digimon's owner relation exactly — a RESTRICT FK (Prisma's SQLite default): a
  // building cannot be orphaned from its user, and users are soft-deleted (never
  // hard-DELETEd — invariant 2), so the RESTRICT is never actually hit.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Which building this is — one of "MeatFarm" | "BitBank" | "DataCenter". Modeled
  // as a plain String, NOT a Prisma `enum`: the SQLite provider does not support
  // enums (an `enum { … }` block fails `prisma generate` / `db push`). The allowed
  // set lives as TS string-union types on the seed (farm.seed.ts) and is enforced
  // in application code where it matters (TASK-15), not in the schema; the eventual
  // Postgres swap can tighten this to an enum then.
  kind String

  // The resource type this building produces — one of "Meat" | "Bits" | "Data".
  // Plain String for the same SQLite-no-enums reason as `kind`.
  resource String

  // Whole resource units produced per real-time hour. The accrual TASK-15 computes
  // on read is `floor(ratePerHour · elapsedHours)` clamped to `capacity`. Int (not
  // Float/Decimal) — the house whole-unit idiom, which also keeps the Postgres-swap
  // portability story simple.
  ratePerHour Int

  // The storage cap the accrued buffer clamps to (offline production stops
  // accumulating once the buffer is full, so a building is worth collecting before
  // it caps). Int, whole units.
  capacity Int

  // The accrual-clock anchor: a computed-on-read diff measures (now − this) to work
  // out how much has been produced since the last collect. Defaults to now() on
  // creation (a freshly granted building starts accruing immediately). TASK-15
  // reads it; R-4b's collect mutation resets it to now() when banking the buffer.
  lastCollectedAt DateTime @default(now())

  createdAt DateTime @default(now())

  // Soft-delete marker (invariant 2: player-owned/economic records are NEVER hard
  // DELETEd — a Building is owned/active when this is NULL). Reads MUST filter
  // `deletedAt: null`; demolishing/selling a building later stamps this rather than
  // issuing a destructive DELETE. No delete path is built in R-4 at all; the marker
  // is declared in the FIRST Building migration so the guarantee predates the data.
  deletedAt DateTime?

  // Index the owner FK: the primary access path is "this player's buildings"
  // (`WHERE userId = ?`, TASK-15's `/farm` read), so the index keeps that query
  // cheap as a player acquires more buildings.
  @@index([userId])
}

/// A per-user, per-resource SPENDABLE balance (TASK-21, R-4b) — the persistence
/// foundation of the game's economy. R-4b's outcome: collecting a building's
/// accrued production (TASK-22's `POST /farm/collect`) banks it INTO one of these
/// rows, and later slices (evolve cost R-8b, shop spend R-13) DEBIT from it. THIS
/// row is "how much of resource X this account currently has banked and can spend".
///
/// This slice is the model + migration + a datastore e2e ONLY — running
/// persistence code, NOT a schema write-up. No write path yet: TASK-22 owns the
/// collect mutation that UPSERTS this on `(userId, resource)`; nothing but a Nest
/// module (via `PrismaService`) ever touches it (invariant 1).
///
/// Shape mirrors `Building` (house owned-instance idiom): a cuid PK, a `userId` FK
/// + `@relation`, plain-`String` categoricals (SQLite has no enums), `Int`
/// numerics, a soft-delete marker (invariant 2), and `@@index([userId])`. The two
/// deltas from `Building` are deliberate and central to R-4b:
///   1. an `@@unique([userId, resource])` — a balance is ONE row per user+resource,
///      which is exactly the upsert key TASK-22 credits on;
///   2. an `updatedAt` — unlike a `Building` (whose accrual clock is a domain
///      field), a BALANCE is a mutable running total (collect increments it, spends
///      decrement it), so the standard `@updatedAt` audit stamp belongs here.
model ResourceBalance {
  // House PK idiom (matches User/Digimon/RefreshToken/Building): a cuid() string,
  // collision-resistant and portable across the future Postgres swap — NOT a DB
  // auto-increment to migrate.
  id String @id @default(cuid())

  // The owning player. `userId` is the FK column; `user` is the relation to the
  // owner. This is what makes a balance a per-ACCOUNT amount and powers the
  // owner-scoped read `findMany({ where: { userId, deletedAt: null } })` (TASK-22).
  // Mirrors Building's owner relation exactly — a RESTRICT FK (Prisma's SQLite
  // default): a balance cannot be orphaned from its user, and users are
  // soft-deleted (never hard-DELETEd — invariant 2), so the RESTRICT is never hit.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Which resource this balance is denominated in — one of "Meat" | "Bits" |
  // "Data" (the same vocabulary `Building.resource` produces). Modeled as a plain
  // String, NOT a Prisma `enum`: the SQLite provider does not support enums (an
  // `enum { … }` block fails `prisma generate` / `db push`, L-6 #3). The allowed
  // set lives as a TS string-union type where it is USED (TASK-22's service /
  // TASK-23's types), not in the schema; the eventual Postgres swap can tighten it.
  resource String

  // The whole spendable units currently banked for this (user, resource). `Int`
  // (not Float/Decimal) — the house whole-unit idiom, which also keeps the
  // Postgres-swap portability story simple. Defaults to 0: a freshly created
  // balance holds nothing; TASK-22's collect does `amount: { increment: n }`.
  amount Int @default(0)

  createdAt DateTime @default(now())

  // A BALANCE is mutable (collect increments it; later spends decrement it), so —
  // unlike Building's domain accrual clock — the standard `@updatedAt` write-stamp
  // belongs here: it records WHEN the running total last changed, complementing the
  // AuditLog's per-mutation before/after ledger. This is why ResourceBalance
  // carries `updatedAt` and Building does not.
  updatedAt DateTime @updatedAt

  // Soft-delete marker (invariant 2: player-owned/economic records are NEVER hard
  // DELETEd — a balance is active when this is NULL). Reads MUST filter
  // `deletedAt: null` (TASK-22/23). No delete path is built in this slice; the
  // marker is declared in the FIRST ResourceBalance migration, BEFORE any balance
  // data exists, so the soft-delete guarantee predates the data.
  deletedAt DateTime?

  // ONE balance row per (user, resource). This composite unique is the UPSERT KEY
  // TASK-22 credits on (`upsert({ where: { userId_resource: { userId, resource } },
  // create: {…}, update: { amount: { increment: n } } })`), so two credits to the
  // same pair land on ONE row (summed), never two. It is the DB-level guarantee
  // that a user cannot end up with split/duplicate balances for a resource.
  @@unique([userId, resource])
  // Index the owner FK: the primary access path is "this player's balances"
  // (`WHERE userId = ?`), so the index keeps that read cheap. (The unique above
  // also indexes the `(userId, resource)` point lookup the upsert uses.)
  @@index([userId])
}

/// The project's FIRST append-only AUDIT LEDGER (TASK-21, R-4b) — invariant 3's
/// machinery. Invariant 3 makes an append-only audit log MANDATORY for every
/// economic/admin/moderation mutation: who / what / when / before→after. R-4 was
/// carved read-only (D-36) precisely so this ledger did not have to exist yet;
/// R-4b stands it up HERE, and it is reused by R-8b (evolve cost), R-13 (shop
/// spend) and R-14 (admin actions). One row = one recorded mutation's evidence.
///
/// This slice is the model + migration + a datastore e2e ONLY. TASK-22 writes the
/// FIRST row (inside the same `$transaction` as the collect it records); nothing
/// but a Nest module (via `PrismaService`) ever touches it (invariant 1).
///
/// APPEND-ONLY BY SHAPE — this is the point of the task. Unlike every other model
/// here, AuditLog intentionally has NO `updatedAt` and NO `deletedAt`: a ledger row
/// is written once and NEVER updated or (soft-)deleted. No code in this or any
/// later task updates/deletes a row. That immutability IS invariant 3's guarantee —
/// the record of what happened cannot be altered after the fact. The absence of
/// those columns is deliberate; do NOT add them.
model AuditLog {
  // House PK idiom: a cuid() string, collision-resistant, Postgres-swap portable.
  id String @id @default(cuid())

  // The player whose action/economy this row records. `userId` is the FK column;
  // `user` is the relation. RESTRICT FK like every other model (users are
  // soft-deleted, never hard-DELETEd), so the audit trail outlives nothing it
  // should. Owner-scoped reads use `@@index([userId])` below.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // WHAT kind of mutation this was — "collect" for TASK-22 (later: "evolve-spend",
  // "shop-purchase", "admin-grant", …). Plain String, NOT an enum (SQLite-no-enums,
  // L-6 #3); the allowed vocabulary lives as a TS string-union where it is written.
  action String

  // WHICH kind of thing was acted on — "Building" for the collect (later: "Digimon"
  // for evolve-spend, "Order" for a purchase, …). Plain String (same no-enums
  // reason). `entity` + `entityId` together identify the acted-on record without a
  // hard FK to every possible target table (a ledger references many entity kinds).
  entity String

  // The id of the specific acted-on record (the building id for a collect; later a
  // digimon id, an order id, …). A plain String, deliberately NOT a typed FK: the
  // ledger spans MANY entity kinds, so a per-target FK is impossible; the
  // `@@index([entity, entityId])` below makes "all audit rows for this record" cheap.
  entityId String

  // The resource this mutation affected — "Meat" | "Bits" | "Data" — or NULL when
  // the action names no single resource (e.g. a future non-economic admin action).
  // Plain String (no-enums); NULLABLE precisely because not every audited action is
  // resource-denominated.
  resource String?

  // The before→after halves of invariant 3: the affected balance's `amount` BEFORE
  // and AFTER this mutation. Storing both (not just a delta) makes the ledger
  // self-contained — an auditor reads the exact state transition without replaying
  // history. `Int`, whole units, the house idiom. For a collect: amountBefore = the
  // balance prior to banking, amountAfter = it plus the collected amount.
  amountBefore Int
  amountAfter  Int

  createdAt DateTime @default(now())

  // ── APPEND-ONLY: intentionally NO `updatedAt`, NO `deletedAt`. The ledger is
  // immutable — a row is written once and never mutated or (soft-)deleted. This
  // absence IS invariant 3's guarantee; do NOT add those columns or any update/
  // delete code path against this table. ──

  // Index the owner FK: "this player's audit history" (`WHERE userId = ?`) is a
  // primary read path.
  @@index([userId])
  // Index the (entity, entityId) pair: "the full audit trail for THIS record"
  // (e.g. every mutation against building X) is the other primary read path —
  // TASK-22's test retrieves the collect's row by this access path.
  @@index([entity, entityId])
}

/// A player-created MARKET LISTING (TASK-42, R-10) — the smallest runnable slice of
/// the player market: a seller offers ONE of their OWNED Digimon for a DigiCredits
/// price, all open listings are visible to every player, and a DIFFERENT player BUYS
/// it — DigiCredits transfer seller↔buyer and the Digimon changes hands (`userId`
/// reassignment on the Digimon row), audit-logged on BOTH sides, all atomic. THIS row
/// records one such offer.
///
/// This is a purely ADDITIVE change (invariant 5): a NEW model behind a NEW additive
/// migration (the ten prior byte-stable), a NEW MarketModule, and three NEW guarded
/// `/api/market*` routes. No existing model/route/shape changes — a sold Digimon's
/// `userId` reassignment is a DATA move visible on the EXISTING `GET /digimon`, not a
/// schema/contract change.
///
/// Shape mirrors the house owned-instance idiom (Digimon/Building): a cuid PK, a
/// `sellerId` FK + `@relation` + `@@index([sellerId])`, plain-`String` categoricals
/// (SQLite has no enums, L-6), `Int` numerics, and a `deletedAt` soft-delete marker
/// (invariant 2). Two deltas from a plain owned model are deliberate:
///   1. `status` — a listing's lifecycle ('open' | 'sold' | 'cancelled'), a plain
///      String union (SQLite-no-enums); the buy transaction flips 'open' → 'sold'.
///   2. `digimonId` — a plain String reference to the LISTED Digimon (deliberately NOT
///      a typed FK/relation: the Digimon it points at is re-read owner-scoped to the
///      seller inside the buy tx, and the listing outlives the ownership move; a hard
///      relation would force a back-relation + more migration surface for no behaviour
///      this slice needs).
model MarketListing {
  // House PK idiom (matches every other model): a cuid() string, collision-resistant
  // and portable across the future Postgres swap — NOT a DB auto-increment.
  id String @id @default(cuid())

  // The player who created the listing. `sellerId` is the FK column; `seller` is the
  // relation to the owner. RESTRICT FK like every other model (users are soft-deleted,
  // never hard-DELETEd — invariant 2), so a listing is never orphaned from its seller.
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  // The LISTED Digimon's id — a plain String reference, NOT a typed FK/relation (see
  // the model doc): the buy tx re-reads the Digimon owner-scoped to the seller, and
  // the listing survives the ownership reassignment.
  digimonId String

  // The asking price in DigiCredits (the premium currency — see shop/shop.seed.ts's
  // PREMIUM_CURRENCY, the single source of truth the service imports). Int, whole
  // units, the house numeric idiom. The service guards `>= 1` at list time (a free/
  // negative listing is nonsensical); the buyer must have at least this many
  // DigiCredits or the buy 422s.
  priceCredits Int

  // The listing's lifecycle: "open" (buyable) | "sold" (a buy completed) | "cancelled"
  // (delisted — a carved R-10 child cancel flow will set this). Plain String union
  // (SQLite-no-enums, L-6); `@default("open")` so a freshly created listing is
  // immediately buyable. `GET /api/market` shows only `status: "open"` rows; the buy
  // tx flips the bought listing to "sold" so it cannot be bought twice (a 2nd buy of a
  // now-sold listing is a 409).
  status String @default("open")

  createdAt DateTime @default(now())

  // Soft-delete marker (invariant 2: player-owned/economic records are NEVER hard
  // DELETEd — a listing is active when this is NULL). Reads filter `deletedAt: null`.
  // No hard-delete path exists; a future delist/cancel flow stamps `status` and/or
  // this marker rather than issuing a destructive DELETE.
  deletedAt DateTime?

  // Index the seller FK: "this seller's listings" (`WHERE sellerId = ?`) is a primary
  // read path (and the open-listings read scans by status), so the index keeps the
  // owner path cheap as listings grow.
  @@index([sellerId])
}

/// A FRIENDSHIP edge between two players (TASK-44, R-11) — the smallest runnable slice
/// of the social feature: a player sends a friend request to another player by email,
/// the other player accepts, and both then see each other in a friends list with a
/// `lastSeenAt`-derived `online` indicator. THIS row records one such request/friendship.
///
/// This is a purely ADDITIVE change (invariant 5): a NEW model behind a NEW additive
/// migration (the eleven prior byte-stable), a NEW `User.lastSeenAt DateTime?` nullable
/// column, a NEW SocialModule, and three NEW guarded `/api/social*` routes. No existing
/// model/route/shape changes.
///
/// Shape mirrors the house owned-instance idiom, with a DIRECTIONAL twist: instead of a
/// single `userId` owner, an edge has a `requester` (who initiated it) and an
/// `addressee` (who may accept it) — two FK columns, each a named `@relation` back to
/// `User` + its own `@@index`. RESTRICT on delete like every other FK (users are
/// soft-deleted, never hard-DELETEd — invariant 2), so an edge is never orphaned.
/// `status` is a plain-`String` union ('pending' | 'accepted'), SQLite-no-enums (L-6);
/// `deletedAt` is the invariant-2 soft-delete marker. The `@@unique([requesterId,
/// addresseeId])` forbids two edges in the SAME direction between the same pair; the
/// service ALSO guards the reverse direction (an existing A→B blocks a B→A duplicate).
model Friendship {
  // House PK idiom (matches every other model): a cuid() string, collision-resistant
  // and portable across the future Postgres swap — NOT a DB auto-increment.
  id String @id @default(cuid())

  // The player who SENT the request. `requesterId` is the FK column; `requester` is the
  // named relation ("FriendRequests" — the sent side). RESTRICT FK (users are
  // soft-deleted, never hard-DELETEd — invariant 2), so an edge is never orphaned.
  requesterId String
  requester   User   @relation("FriendRequests", fields: [requesterId], references: [id], onDelete: Restrict)

  // The player the request was sent TO. `addresseeId` is the FK column; `addressee` is
  // the named relation ("FriendRequestsReceived" — the received side). ONLY the
  // addressee may accept a pending edge (SocialService enforces this at the service
  // boundary → 403 otherwise). RESTRICT FK like `requester`.
  addresseeId String
  addressee   User   @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Restrict)

  // The edge's lifecycle: "pending" (a request awaiting the addressee's accept) |
  // "accepted" (a mutual friendship). Plain String union (SQLite-no-enums, L-6);
  // `@default("pending")` so a freshly created request awaits acceptance. `GET
  // /api/social/friends` reads `accepted` edges (the friends list) + `pending` edges
  // addressed to the caller (the incoming requests); the accept path flips
  // 'pending' → 'accepted'. (A future decline/unfriend flow would add 'declined' /
  // stamp `deletedAt` — carved to an R-11 child, no code path sets those yet.)
  status String @default("pending")

  createdAt DateTime @default(now())

  // Soft-delete marker (invariant 2: player-owned/social records are NEVER hard
  // DELETEd — an edge is active when this is NULL). Reads filter `deletedAt: null`.
  // No hard-delete path exists this slice; a future decline/unfriend flow stamps this
  // rather than issuing a destructive DELETE.
  deletedAt DateTime?

  // Index each FK: "requests I sent" (`WHERE requesterId = ?`) and "requests I received"
  // (`WHERE addresseeId = ?`) are both primary read paths for the friends view.
  @@index([requesterId])
  @@index([addresseeId])

  // At most ONE edge per ORDERED pair (requester, addressee) — the DB-level guarantee a
  // client cannot create two identical A→B requests. The reverse direction (B→A) is
  // guarded in application code (SocialService checks BOTH directions before creating),
  // since a composite unique on an unordered pair is not expressible here.
  @@unique([requesterId, addresseeId])
}

/// A player-OWNED inventory item stack (TASK-262, R-31b) — the space-limited
/// roguelike inventory of consumable chips (heal/revive/encounter-prevent). This
/// slice models the buy→own→see arc: a shop purchase of an `'inventory_item'`-kind
/// catalog entry GRANTS one unit (upsert-increment), `GET /api/inventory` reads the
/// owned stacks, and the Inventory rail renders them. Per-item USE/DISCARD, the
/// 10-slot capacity cap, and the on-loss wipe are follow-on children (R-31e).
///
/// Mirrors {@link ResourceBalance} EXACTLY (its owner-scoped additive-model shape):
/// a cuid PK, a RESTRICT-FK owner relation (users are soft-deleted, never hard-
/// DELETEd — invariant 2, so the RESTRICT is never hit), a plain-String slug (SQLite
/// has no enums — L-6; the vocabulary is the shop catalog's item ids), an Int
/// `quantity @default(0)`, the createdAt/updatedAt stamps, and the
/// `@@unique([userId, itemId])` composite that is the UPSERT KEY a grant increments
/// on (so two grants of the same item land on ONE row, summed, never two).
model InventoryItem {
  // House PK idiom (matches User/ResourceBalance): a cuid() string, collision-
  // resistant and portable across the future Postgres swap.
  id String @id @default(cuid())

  // The owning player. `userId` is the FK column; `user` is the relation to the
  // owner. This is what makes an inventory stack a per-ACCOUNT holding and powers
  // the owner-scoped read `findMany({ where: { userId } })`. Mirrors
  // ResourceBalance's owner relation — a RESTRICT FK (Prisma's SQLite default).
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Which catalog item this stack holds — the shop item's stable slug (the SAME
  // vocabulary a purchase names). Plain String, NOT a Prisma enum (SQLite-no-enums,
  // L-6); the allowed set lives on SHOP_ITEMS where it is used.
  itemId String

  // The whole units of this item the player currently owns. Int (house whole-unit
  // idiom); defaults to 0 (a freshly created stack holds nothing — a grant does
  // `quantity: { increment: 1 }`).
  quantity Int @default(0)

  createdAt DateTime @default(now())

  // A stack is mutable (a grant increments it; a future USE decrements it), so the
  // standard `@updatedAt` write-stamp belongs here (like ResourceBalance, unlike a
  // Building).
  updatedAt DateTime @updatedAt

  // ONE stack row per (user, item slug). This composite unique is the UPSERT KEY a
  // grant credits on (`upsert({ where: { userId_itemId: { userId, itemId } },
  // create: {…}, update: { quantity: { increment: 1 } } })`), so two grants of the
  // same item land on ONE row (summed), never two — the DB-level guarantee against
  // split/duplicate stacks.
  @@unique([userId, itemId])
  // Index the owner FK: the primary access path is "this player's inventory"
  // (`WHERE userId = ?`).
  @@index([userId])
}
