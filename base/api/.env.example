# apps/api — environment template. Copy to apps/api/.env (git-ignored) to override.
# Port the NestJS server binds (default 3000).
PORT=3000
# Allowed browser origin(s) for CORS — the web dev server. Comma-separate for many.
WEB_ORIGIN=http://localhost:5173
# Prisma datastore connection (TASK-4). SQLite for now. This relative path is the
# app-package-root view (apps/api/prisma/dev.db); the app resolves it to an
# absolute path at boot so `pnpm dev` connects regardless of CWD. When DATABASE_URL
# is unset the app falls back to exactly this value (house `process.env.X ?? default`
# idiom). First-time local setup: run `pnpm --filter @digimon/api db:deploy` to
# create + migrate the DB file, then `pnpm dev`. The Postgres swap (later slice)
# changes this to a postgresql:// URL + the schema provider; no app code changes.
# dev.db is git-ignored — never commit it.
DATABASE_URL="file:./prisma/dev.db"
# JWT access-token signing (TASK-5). Secret for signing/verifying the short-lived
# access token issued by POST /auth/login and checked by GET /auth/me. REQUIRED in
# any real deployment — when unset the app falls back to a clearly-marked dev-only
# secret (house `process.env.X ?? default` idiom) so a fresh clone / the test gate
# still runs; NEVER ship with the fallback. Generate a strong value, e.g.
# `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-only-insecure-jwt-secret-change-me
# Access-token lifetime (any value the `jsonwebtoken` library accepts — a number of
# seconds, or a span like `15m` / `1h`). Short by design; durable "stay logged in"
# via a refresh token is a later slice (R-2b). Defaults to 15m when unset.
JWT_ACCESS_TTL=15m
# JWT refresh-token signing (TASK-11, R-2b). Secret for signing/verifying the
# LONG-lived refresh token carried in the httpOnly cookie (rotated by
# POST /auth/refresh, revoked by POST /auth/logout). MUST be DISTINCT from
# JWT_ACCESS_SECRET so a refresh token can never be replayed as an access token (or
# vice versa). REQUIRED in any real deployment — when unset the app falls back to a
# clearly-marked dev-only secret (house `process.env.X ?? default` idiom) so a fresh
# clone / the test gate still runs; NEVER ship with the fallback. Generate a strong
# value, e.g. `openssl rand -base64 48`.
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me
# Refresh-token lifetime (any value `jsonwebtoken` accepts — e.g. `30d`, `7d`). This
# is the "stay logged in across reloads / a browser restart" window: while the
# rotating cookie is presented within it, the SPA silently mints fresh access tokens
# without re-entering credentials. Defaults to 30d when unset.
JWT_REFRESH_TTL=30d
# Refresh-cookie `Secure` attribute toggle (TASK-11). MUST be `false`/unset in local
# dev: a `Secure` cookie is dropped by the browser over plain-HTTP `localhost`, which
# would silently break the Vite(:5173) → Nest(:3000) dev-proxy round-trip. Set to
# `true` in any HTTPS deployment so the refresh cookie is only ever sent over TLS.
COOKIE_SECURE=false
# Admin bootstrap allow-list (TASK-34, R-14). Comma-separated emails that are granted
# the "admin" authorization tier on register/login (matched case-insensitively). This
# is the FIRST tier beyond bare "authenticated": an admin can reach the guarded
# admin-panel routes (e.g. POST /api/admin/grant, which credits a target player's
# balance with an audit row). Plain local config — NO external service/key is
# required, so nothing is blocked when it is unset. Defaults to EMPTY (nobody is an
# admin) — set it to the operator's own account email to bootstrap the first admin,
# e.g. ADMIN_EMAILS=ops@example.com,admin@example.com
ADMIN_EMAILS=
