{
  "name": "@digimon/api",
  "version": "0.0.0",
  "private": true,
  "description": "Digimon backend — NestJS 10 + TypeScript. Boots and listens on a configurable port; server-authoritative API layer (invariant 1). Routes are added by later slices (TASK-2 adds /health).",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=file:./dev.db prisma migrate dev",
    "db:deploy": "DATABASE_URL=file:./dev.db prisma migrate deploy",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/platform-socket.io": "10.4.4",
    "@nestjs/websockets": "10.4.4",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.4",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/node": "22.5.5",
    "prisma": "5.22.0",
    "socket.io-client": "4.8.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
