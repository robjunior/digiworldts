POSTGRES_PASSWORD=change-me-to-a-strong-password
REDIS_PASSWORD=change-me-to-a-strong-redis-password
SESSION_SECRET=change-me-to-a-random-32-plus-character-secret-please
# SECURITY: default `closed` prevents the first-user-is-admin race on public
# deploys. To bootstrap the first admin: temporarily flip to `open`, register
# the admin account through the UI, then set back to `closed` and restart.
ADMIN_BOOTSTRAP=closed
HOST_PORT=8080
# Comma-separated list of allowed CORS origins. Empty (default) = no CORS plugin.
# Use '*' to allow all origins. Example: CORS_ORIGINS=http://localhost:5173,https://digiworld.example.com
CORS_ORIGINS=
# Cloudflare tunnel token for the cloudflared service. Get from https://one.dash.cloudflare.com > Networks > Tunnels > (your tunnel) > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Discord commerce service (OPTIONAL) ──────────────────────────────────────
# The discord-bot service sits behind the "discord" compose profile, so a plain
# `docker compose up` ignores it entirely and none of the vars below are needed.
# To run it:  docker compose --profile discord up
# Discord commerce service public origin used for OAuth callback URLs.
DISCORD_PUBLIC_URL=http://localhost:3100
# Where players reach the game itself. The /link command points users here to
# fetch their one-time link code. Defaults to localhost:HOST_PORT.
GAME_PUBLIC_URL=http://localhost:8080
# Shared bearer token for backend /api/service/* <-> Discord service calls. Use 32+ random chars.
SERVICE_TOKEN_DISCORD=change-me-to-a-random-32-plus-character-service-token
# Discord Developer Portal credentials. Optional for Wave 1 health checks.
DISCORD_TOKEN=REPLACE_ME_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=REPLACE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_ME_DISCORD_CLIENT_SECRET
DISCORD_GUILD_ID=REPLACE_ME_DEV_GUILD_ID
# Comma-separated Discord role IDs allowed to use admin commerce commands.
DISCORD_ADMIN_ROLE_IDS=
# MercadoPago sandbox/test credentials. Optional for Wave 1 health checks.
MP_ACCESS_TOKEN=REPLACE_ME_MERCADOPAGO_TEST_ACCESS_TOKEN
MP_WEBHOOK_SECRET=change-me-mp-webhook-secret
# PIX payer fields required by MercadoPago checkout API. Use sandbox-safe fake
# test identities only in dev/CI; never commit production personal data.
MP_PAYER_EMAIL=buyer@example.test
MP_PAYER_NAME=Sandbox
MP_PAYER_LAST_NAME=Buyer
MP_PAYER_ID_TYPE=CPF
MP_PAYER_ID_NUMBER=12345678909
# Discord commerce runtime knobs.
PIX_EXPIRATION_MINUTES=30
# Expired-purchase sweep cadence. 300000ms = 5 min (matches MercadoPago expiration cadence).
PURCHASE_SWEEP_INTERVAL_MS=300000
# Support ticket auto-close after this many hours of inactivity.
TICKET_INACTIVITY_HOURS=48
RATE_LIMIT_COMMANDS=20
RATE_LIMIT_BUY=3
# DigiCredits granted per BRL 1.00. At 100, credits == centavos (R$10.00 -> 1000 credits).
# Frozen into each purchase_session's metadata at /buy time, so changing this never
# retroactively alters an order that was already paid.
CREDITS_PER_BRL=100
# Per-purchase floor and ceiling in BRL, enforced by /buy before any MercadoPago call.
BUY_MIN_BRL=5
BUY_MAX_BRL=500
