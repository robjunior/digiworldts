# ─── DigiWorld Environment Configuration ───────────────────────────────────
#
# This file is the CANONICAL TEMPLATE for all three environments.
#
#   development  →  cp .env.example .env  (edit locally, never commit)
#   staging      →  values live in GitHub Actions Environment `staging`
#   production   →  values live in GitHub Actions Environment `production`
#
# The CI workflows in .github/workflows/deploy-*.yml materialize a .env from
# those Environment secrets/variables at deploy time using
# scripts/materialize-env.sh, so every variable below MUST be defined in every
# environment (or have a code default).
#
# See docs/environments.md for the full mapping table + setup checklist.
# ────────────────────────────────────────────────────────────────────────────

# ─── Base infrastructure ────────────────────────────────────────────────────

# SECRET. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-strong-password

# SECRET. Generate: openssl rand -base64 24
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# SECRET. Cookie signing key. 32+ random chars. openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-secret-please

# `closed` (recommended) prevents the first-user-is-admin race on public
# deploys. Temporarily flip to `open` to bootstrap the first admin through
# the UI, then flip back to `closed` and restart.
#   dev:        closed (briefly `open` during first-admin bootstrap)
#   staging:    closed
#   production: closed
ADMIN_BOOTSTRAP=closed

# Host-side port for the nginx / game backend.
HOST_PORT=8080

# Host-side port for the standalone admin panel (opt-in via the `admin`
# compose profile). Only bound when you run `docker compose --profile admin up`.
ADMIN_HOST_PORT=8090

# Comma-separated allowed CORS origins. Empty (default) = no CORS plugin.
# Setting ANY origin also flips the session cookie to SameSite=None + Secure
# so cross-site requests from the standalone admin panel are authenticated.
# Use `*` to allow all origins (dev only — Secure+None won't work over http).
#   dev:        empty  OR  http://localhost:5173,http://localhost:5174
#   staging:    https://staging.example.com,https://admin-staging.example.com
#   production: https://digiworld.example.com,https://admin.example.com
CORS_ORIGINS=

# SECRET. Cloudflare Tunnel token — https://one.dash.cloudflare.com > Networks
# > Tunnels > (your tunnel) > Install connector. Empty disables the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Discord commerce service ───────────────────────────────────────────────
#
# The discord-bot service sits behind the `discord` compose profile, so a plain
# `docker compose up` ignores it entirely and none of the vars below are needed.
# To include it:  docker compose --profile discord up
#
# Every var below is REQUIRED when the profile is enabled.

# Public origin the bot's HTTP handler is reachable at. MercadoPago posts its
# webhook to `${DISCORD_PUBLIC_URL}/webhooks/mercadopago` — must be HTTPS and
# reachable from the internet in staging + production (Cloudflared tunnel works).
#   dev:        http://localhost:3100
#   staging:    https://staging.discord.example.com
#   production: https://discord.example.com
DISCORD_PUBLIC_URL=http://localhost:3100

# Public origin where players reach the game itself. The /link command deep-
# links users here to fetch their one-time link code.
#   dev:        http://localhost:8080
#   staging:    https://staging.example.com
#   production: https://example.com
GAME_PUBLIC_URL=http://localhost:8080

# SECRET. Shared bearer token for backend `/api/service/*` <-> Discord service.
# 32+ random chars. openssl rand -base64 32
SERVICE_TOKEN_DISCORD=change-me-to-a-random-32-plus-character-service-token

# SECRET. Discord Developer Portal — https://discord.com/developers/applications
# Use a SEPARATE Discord application per env so staging pushes never spam the
# production bot's guild.
DISCORD_TOKEN=REPLACE_ME_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=REPLACE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_ME_DISCORD_CLIENT_SECRET
DISCORD_GUILD_ID=REPLACE_ME_DEV_GUILD_ID

# Comma-separated Discord role IDs allowed to use admin commerce commands.
DISCORD_ADMIN_ROLE_IDS=

# ─── MercadoPago PIX ────────────────────────────────────────────────────────

# SECRET. MercadoPago access token.
#   dev + staging: SANDBOX/TEST token — starts with `TEST-...`. NEVER a
#                  production token in dev/staging; a paid PIX QR = real money.
#   production:    production token from https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=REPLACE_ME_MERCADOPAGO_TEST_ACCESS_TOKEN

# SECRET. MercadoPago webhook signing secret. Configured in the MP dashboard
# under Webhook settings; validates `x-signature` on inbound webhooks.
MP_WEBHOOK_SECRET=change-me-mp-webhook-secret

# PII / SECRET. Payer identity fields REQUIRED by MercadoPago's PIX API. The
# /buy flow refuses to generate a PIX QR unless ALL five are set.
#   dev + staging: sandbox-safe fake identities (defaults below are fine)
#   production:    real business-registered identity
MP_PAYER_EMAIL=buyer@example.test
MP_PAYER_NAME=Sandbox
MP_PAYER_LAST_NAME=Buyer
MP_PAYER_ID_TYPE=CPF
MP_PAYER_ID_NUMBER=12345678909

# ─── Discord commerce runtime knobs ─────────────────────────────────────────
# Non-secret. All have code defaults; override per env only if you need to.

# How long a PIX QR stays payable before expiring (matched to MP defaults).
PIX_EXPIRATION_MINUTES=30

# Cadence at which the expired-purchase sweeper runs. 300000ms = 5 min.
PURCHASE_SWEEP_INTERVAL_MS=300000

# Support ticket auto-close inactivity threshold.
TICKET_INACTIVITY_HOURS=48

# Per-user command rate limit (rolling window).
RATE_LIMIT_COMMANDS=20
RATE_LIMIT_BUY=3

# DigiCredits granted per BRL 1.00. Snapshotted per purchase_session at /buy
# time — changing this NEVER retroactively alters an already-paid order.
CREDITS_PER_BRL=100

# Per-purchase floor + ceiling in BRL, enforced before any MercadoPago call.
BUY_MIN_BRL=5
BUY_MAX_BRL=500
