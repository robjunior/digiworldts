{
  "name": "@digiworld/admin",
  "version": "0.1.0",
  "private": true,
  "description": "DigiWorld admin panel — standalone Vite + React SPA that can point at dev/staging/production backends via VITE_BACKEND_URL.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@digiworld/scene3d": "workspace:*",
    "@digiworld/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "three": "^0.185.1",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.7.4",
    "three-stdlib": "^2.36.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
