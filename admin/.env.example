# ─── DigiWorld Admin Environment Configuration ─────────────────────────────
#
# The admin is a standalone Vite/React SPA that can point at ANY backend
# environment via VITE_BACKEND_URL. In dev mode the Vite proxy makes
# cross-origin cookies transparent (see vite.config.ts).
#
# Presets:
#   pnpm --filter @digiworld/admin dev            → uses .env.dev
#   pnpm --filter @digiworld/admin dev:staging    → uses .env.staging
#   pnpm --filter @digiworld/admin dev:production → uses .env.production (careful!)
#
# Copy this file to `.env.local` to override any preset locally
# (`.env.local` beats `.env.<mode>` in Vite).
# ────────────────────────────────────────────────────────────────────────────

# Backend to proxy /api and /ws against. Full origin, no trailing slash.
VITE_BACKEND_URL=http://localhost:3000

# Displayed in the top-of-screen banner. Values: dev | staging | production
VITE_ENV_LABEL=dev

# Optional cosmetic title override (defaults to "SOULXENON — Admin (<label>)")
VITE_ADMIN_TITLE=
