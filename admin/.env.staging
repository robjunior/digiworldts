# Staging. The admin container serves this SPA behind its own nginx, which
# proxies /api and /ws to `backend:3000` — so the browser talks to ONE origin and
# no CORS or cross-site cookie is involved. VITE_BACKEND_URL is display-only in
# that setup (banner, login footer, confirm dialogs); api.ts fetches relative
# paths.
#
# It still matters for `pnpm --filter @digiworld/admin dev:staging`, which points
# a LOCAL admin at the deployed staging backend through the Vite proxy.
VITE_BACKEND_URL=https://admstag.xenon.dev.br
VITE_ENV_LABEL=staging
VITE_ADMIN_TITLE=
