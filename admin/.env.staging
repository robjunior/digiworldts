# Staging. Set VITE_BACKEND_URL to the staging origin.
# The Vite dev proxy rewrites the Set-Cookie so remote HttpOnly+Secure+SameSite=None
# cookies still work from http://localhost:5174 (see admin/vite.config.ts).
VITE_BACKEND_URL=https://staging.example.com
VITE_ENV_LABEL=staging
VITE_ADMIN_TITLE=
