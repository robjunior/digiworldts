# Local development. Points at the Docker Postgres-backed backend on :3001
# (the same instance the staging admin at :8090 uses), so world objects,
# regions, dungeons, users, etc. from your live vault are visible.
# Switch to http://localhost:3000 to talk to a locally-spawned `pnpm dev:backend`
# instance (fresh SQLite, isolated data).
VITE_BACKEND_URL=http://localhost:3001
VITE_ENV_LABEL=dev
VITE_ADMIN_TITLE=
