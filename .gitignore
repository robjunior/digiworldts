# deps
node_modules/
pnpm-lock.yaml.bak
package-lock.json
yarn.lock

# build
dist/
*.tsbuildinfo

# env / secrets
.env
.env.local
.env.*.local
# CI-materialized envs (scripts/materialize-env.sh) — never commit
/.env.staging
/.env.production
backend/data/.session-secret
cookie.txt
cookies.txt

# session / dev-tool state
.omo/run-continuation/
.playwright-mcp/
_archive/
.qa/

# local dev-only compose overrides — never commit
/docker-compose.dev.override.yml

# reference material (assets, layouts, .blend files) — not tracked
/base/

# runtime-uploaded tilesets (server-generated ids, safe to regenerate)
backend/data/tilesets/tst_*

# ad-hoc screenshots at repo root
/*.png

# ad-hoc scratch files at repo root
/tmp_*.js
/tmp_*.html
/tmp_*.mjs
/tmp_*.ts
/patch_*.sh
/scratch_*
/scratch/
/take-screens.mjs

# data (SQLite + cached scraper artifacts)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db.bak
backend/data/*.db.pre-*.bak
backend/data/cache/
!backend/data/catalog/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# assets: keep folder shape but not the downloaded blobs (regenerated on startup)
backend/public/assets/digimon/*/
!backend/public/assets/digimon/.keep
backend/public/assets/npc/
backend/data/scenes/

# frontend build output (created in later phase)
frontend/dist/
frontend/.vite/

# runtime logs
logs/
*.log

# editor
.vscode/
.idea/
.DS_Store
*.swp

# temp
/tmp/
tmp/
.tmp/

# codegraph db (existing)
.codegraph/

# OpenCode agent session artifacts (plans, evidence, drafts)
.omo/

# Arena images are written at runtime (ARENAS_DIR) and live in the `arenadata`
# volume in docker; never source.
frontend/public/assets/arenas/
