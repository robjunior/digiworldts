{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./booster.schema.json",
  "title": "BoosterSeed",
  "description": "A DigiWorld booster (edition set) as manual editorial curation. Source of truth is this versioned file; the runtime DB is a build-time cache.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code", "name", "set", "releaseDate", "status", "digimonPool", "itemPool"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Unique across ALL booster seed files."
    },
    "name": { "type": "string", "minLength": 1 },
    "set": { "type": "string", "minLength": 1 },
    "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "review", "published", "archived"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "digimonPool": {
      "type": "array",
      "items": { "$ref": "#/definitions/digimonEntry" }
    },
    "itemPool": {
      "type": "array",
      "items": { "$ref": "#/definitions/itemEntry" }
    }
  },
  "definitions": {
    "rarity": { "enum": ["common", "uncommon", "rare", "ultra-rare"] },
    "digimonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digimonId", "parentRef", "rarity", "weight", "order"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "File-local slug used by parentRef."
        },
        "digimonId": { "type": "string", "minLength": 1 },
        "parentRef": { "type": ["string", "null"] },
        "rarity": { "$ref": "#/definitions/rarity" },
        "weight": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "itemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "itemId", "rarity", "weight", "order"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "itemId": { "type": "string", "minLength": 1 },
        "rarity": { "$ref": "#/definitions/rarity" },
        "weight": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    }
  }
}