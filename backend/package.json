{
  "name": "@digiworld/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Digimon-style 3v3 MMO backend — Fastify + ws + better-sqlite3 + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json && node -e \"const {cpSync,mkdirSync}=require('node:fs');mkdirSync('dist/db',{recursive:true});cpSync('src/db/schema.sql','dist/db/schema.sql');cpSync('src/db/schema-pg.sql','dist/db/schema-pg.sql');cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scrape": "tsx src/scraper/cli.ts",
    "db:init": "tsx src/db/init.ts",
    "test:pg-portability": "tsx test/postgres-portability.mts",
    "test:cluster": "tsx test/cluster-crossnode.mts",
    "test:migrator": "tsx test/migrator-smoke.mts",
    "test:features": "tsx test/features-smoke.mts",
    "test:skill-vfx": "tsx test/skill-vfx-smoke.mts",
    "test:currency": "DB_PATH=/tmp/dw-currency-smoke.db tsx test/currency-smoke.mts",
    "test:discord-link": "DB_PATH=/tmp/dw-discord-link-test.db tsx test/discord-link.mts",
    "test:battle-sim": "tsx test/battle-sim.mts",
    "test:damage-progression": "tsx test/damage-progression.mts",
    "test:battle-combo": "tsx test/battle-combo.mts",
    "test:dsl-runtime": "tsx test/dsl-runtime.mts",
    "test:dialogue-parser": "tsx test/dialogue-parser.mts",
    "test:flags": "DB_PATH=/tmp/dw-flags-smoke.db tsx test/flags-smoke.mts",
    "test:rarity": "DATABASE=sqlite DB_PATH=/tmp/dw-rarity-smoke.db tsx test/rarity-column-smoke.mts",
    "test:dungeon-kits": "DATABASE=sqlite DB_PATH=/tmp/dw-dungeon-kits-smoke.db tsx test/dungeon-kits-smoke.mts",
    "test:dungeon-extraction": "DATABASE=sqlite DB_PATH=/tmp/dw-dungeon-extraction-smoke.db tsx test/dungeon-extraction-smoke.mts",
    "test:dungeon-challenge": "DATABASE=sqlite DB_PATH=/tmp/dw-dungeon-challenge-smoke.db tsx test/dungeon-challenge-smoke.mts",
    "test:tiled-layer-contract": "DATABASE=sqlite DB_PATH=/tmp/dw-tiled-layer-contract-smoke.db tsx test/tiled-layer-contract-smoke.mts",
    "test:evolution-crafting-foundation": "DATABASE=sqlite DB_PATH=/tmp/dw-evolution-crafting-foundation-smoke.db tsx test/evolution-crafting-foundation-smoke.mts",
    "test:factory-rarity-inherit": "DATABASE=sqlite DB_PATH=/tmp/dw-factory-rarity-inherit-smoke.db tsx test/factory-rarity-inherit-smoke.mts",
    "test:dungeon-rarity-table": "DATABASE=sqlite DB_PATH=/tmp/dw-dungeon-rarity-table-smoke.db tsx test/dungeon-rarity-table-smoke.mts",
    "test:rarity-evolution-bonus": "DATABASE=sqlite DB_PATH=/tmp/dw-rarity-evolution-bonus-smoke.db tsx test/rarity-evolution-bonus-smoke.mts",
    "test:admin-item-filter": "DATABASE=sqlite DB_PATH=/tmp/dw-admin-item-filter-smoke.db tsx test/admin-item-filter-smoke.mts",
    "test:dungeon-multi-floor": "DATABASE=sqlite DB_PATH=/tmp/dw-dungeon-multi-floor-smoke.db tsx test/dungeon-multi-floor-smoke.mts",
    "test:quest-flags": "DB_PATH=/tmp/dw-quest-flags-smoke.db tsx test/quest-flags-smoke.mts",
    "test:quest-objectives": "DB_PATH=/tmp/dw-quest-objectives-smoke.db tsx test/quest-objectives-smoke.mts",
    "test:items": "DB_PATH=/tmp/dw-items-smoke.db tsx test/items-grant-smoke.mts",
    "test:evolve-item": "DB_PATH=/tmp/dw-evolve-item-smoke.db CATALOG_XML=/tmp/dw-evolve-item-smoke-catalog.xml tsx test/evolve-item-smoke.mts",
    "test:dialogue-runtime": "DB_PATH=/tmp/dw-dlg-runtime.db tsx test/dialogue-runtime-smoke.mts",
    "test:dialogue-session": "DB_PATH=/tmp/dw-dlg-session.db tsx test/dialogue-session-smoke.mts",
    "test:npc-registry": "DB_PATH=/tmp/dw-npc-registry.db tsx test/npc-registry-smoke.mts",
    "test:onboarding-intro": "DB_PATH=/tmp/dw-onboarding-intro.db tsx test/onboarding-intro-dialogue-smoke.mts",
    "test:dialogue-runtime-b": "DB_PATH=/tmp/dw-dlg-b.db tsx test/dialogue-runtime-b-smoke.mts",
    "test:seed-v2": "tsx test/seed-catalog-v2-smoke.mts",
    "test:pool": "tsx test/pool-smoke.mts",
    "test:backfill": "tsx test/backfill-smoke.mts",
    "test:catalog-e2e": "tsx test/catalog-battle-e2e.mts",
    "db:backfill-equipped": "tsx src/db/data-migrations/populate-equipped-defaults.ts",
    "rebuild:native": "pnpm rebuild better-sqlite3 argon2",
    "test:initiative-sign": "tsx test/initiative-sign.mts",
    "test:element-identity": "tsx test/element-identity.mts"
  },
  "dependencies": {
    "@digiworld/shared": "workspace:*",
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.0",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
