{
  "name": "digiworld",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "Digimon-style 3v3 MMO — monorepo root (backend/frontend/shared)",
  "type": "module",
  "scripts": {
    "shared:build": "pnpm --filter @digiworld/shared build",
    "dev": "pnpm shared:build && pnpm --filter @digiworld/backend dev",
    "dev:backend": "pnpm --filter @digiworld/backend dev",
    "dev:frontend": "pnpm --filter @digiworld/frontend dev",
    "dev:admin": "pnpm --filter @digiworld/admin dev",
    "dev:admin:staging": "pnpm --filter @digiworld/admin dev:staging",
    "dev:admin:production": "pnpm --filter @digiworld/admin dev:production",
    "build": "pnpm -r build",
    "typecheck": "pnpm shared:build && pnpm -r typecheck",
    "test": "pnpm --filter @digiworld/scene3d test",
    "rebuild:native": "pnpm --filter @digiworld/backend rebuild:native",
    "content:deploy": "pnpm --filter @digiworld/backend content:deploy",
    "typecheck:xref": "pnpm --filter @digiworld/backend typecheck:xref"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
