{
  "name": "@digiworld/discord",
  "version": "0.1.0",
  "private": true,
  "description": "DigiWorld Discord commerce service — Fastify + discord.js + Postgres",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "register-commands": "tsx src/register-commands.ts",
    "test": "pnpm test:repo && pnpm test:backend-client && pnpm test:commands && pnpm test:i18n && pnpm test:products && pnpm test:commerce-commands && pnpm test:wrapper && pnpm test:payments && pnpm test:purchase-state && pnpm test:webhook-orchestrator && pnpm test:buy-sweep && pnpm test:notifications && pnpm test:purchases && pnpm test:admin",
    "test:repo": "tsx test/repo.mts",
    "test:backend-client": "tsx test/backend-client.mts",
    "test:commands": "tsx test/commands.mts",
    "test:i18n": "tsx test/i18n.mts",
    "test:products": "tsx test/products.mts",
    "test:commerce-commands": "tsx test/commerce-commands.mts",
    "test:wrapper": "tsx test/wrapper.mts",
    "test:payments": "tsx test/payments.mts",
    "test:purchase-state": "tsx test/purchase-state.mts",
    "test:webhook-orchestrator": "tsx test/webhook-orchestrator.mts",
    "test:buy-sweep": "tsx test/buy-sweep.mts",
    "test:notifications": "tsx test/notifications.mts",
    "test:purchases": "tsx test/purchases.mts",
    "test:admin": "tsx test/admin.mts"
  },
  "dependencies": {
    "discord.js": "^14.26.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pino": "^9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@electric-sql/pglite": "0.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
